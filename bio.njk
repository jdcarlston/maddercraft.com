---
layout: base.njk
title: Bio
permalink: /bio/
eleventyComputed:
  description: "{{ pages['bio'].description }}"
---
{#- The words are in _data/pages/bio.yml (edit in /admin under Pages). The portrait lives in /assets/img/bio/.
    The bio's buttons sit under the text, so the heading block is given everything except them. -#}
{%- set bio = pages.bio %}
{%- set p = { label: bio.label, title: bio.title, intro: bio.intro } %}
{% include "page-head.njk" %}
<div class="wrap bio">
  <figure class="bio__photo">
    <img src="{{ '/assets/img/bio/portrait.jpg' | resized(900) }}" alt="{{ bio.photoAlt }}">
    <figcaption class="label label--small">Photo by <a href="{{ modeling.credit.url }}">{{ modeling.credit.name }}</a></figcaption>
  </figure>
  <div class="prose bio__text">
    {{ bio.text | markdown | safe }}
    {%- if bio.buttons %}{% set buttons = bio.buttons %}
    <p>{% include "buttons.njk" %}</p>
    {%- endif %}
  </div>
</div>
