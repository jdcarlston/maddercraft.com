---
layout: base.njk
title: Art
permalink: /art/
eleventyComputed:
  description: "{{ pages['art'].description }}"
---
{# The words are in _data/pages/art.yml (editable in /admin). #}
{#- The words are in _data/pages/art.yml; the intro and pieces are in _data/art.yml (edit both in /admin). -#}
{% set p = { label: pages.art.label, title: pages.art.title, intro: art.intro, buttons: pages.art.buttons } %}{% include "page-head.njk" %}
{#- In progress: the larger projects (one Markdown file each in projects/, pages at /workshop/<name>/). -#}
<div class="wrap"><h2 class="label section-label" id="in-progress">{{ pages.art.inProgressHeading }}</h2>
  <p class="intro section-intro">{{ pages.art.inProgressIntro | markdownInline | safe }}</p></div>
{% set projects = collections.projects | byOrder %}
{% include "project-cards.njk" %}

{#- The finished pieces (_data/art.yml). -#}
<div class="wrap"><h2 class="label section-label" id="creations">{{ pages.art.creationsHeading }}</h2></div>
<div class="wrap gallery">
  {% for p in art.pieces %}
  <figure class="gallery__item" data-name="{{ p.file | fileName }}">
    <a href="{{ p.page or (('/assets/img/art/' + p.file) | original) }}"><img src="{{ ('/assets/img/art/' + p.file) | resized }}" alt="{{ p.alt }}" loading="lazy"></a>
    {% if p.title %}<figcaption><span class="tile__title">{{ p.title }}</span>{% if p.medium %}<span class="tile__note">{{ p.medium }}</span>{% endif %}</figcaption>{% endif %}
  </figure>
  {% endfor %}
</div>
