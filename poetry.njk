---
layout: base.njk
title: Poetry
permalink: /poetry/
description: Poems from Madder Craft.
---
<section class="page-head wrap">
  <p class="label">Poetry</p>
  <h1 class="title">Poems</h1>
  <p class="intro">{{ collections.poems.length }} poems, newest first.</p>
</section>
<div class="wrap">
  {% set lastYear = "" %}
  {% for p in collections.poems %}{% set y = p.date | year %}
  {% if y != lastYear %}{% if lastYear %}</ul>{% endif %}<h2 class="year">{{ y }}</h2><ul class="index">{% set lastYear = y %}{% endif %}
  <li><a href="{{ p.url }}">{{ p.data.title }}</a><span class="label label--small">{{ p.date | monthYear }}</span></li>
  {% endfor %}</ul>
</div>
