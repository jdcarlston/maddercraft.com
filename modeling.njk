---
layout: base.njk
title: Fashion
permalink: /fashion/
eleventyComputed:
  description: "{{ pages['fashion'].description }}"
---
{#- The Fashion page (the file and its photo folder keep the old name "modeling"). Words: _data/pages/fashion.yml.
    Photos: _data/modeling.yml. Edit both in /admin. The styling section sits just under the heading (#styling). -#}
{%- set p = pages.fashion %}
{%- set headExtra %}<p class="credit label label--small">Photography by <a href="{{ modeling.credit.url }}">{{ modeling.credit.name }}</a></p>{% endset %}
{% include "page-head.njk" %}
{#- Styling consultations: the words are in `styling` in _data/pages/fashion.yml. -#}
{%- set st = pages.fashion.styling %}
<section class="wrap" id="styling">
  <p class="label section-label">{{ st.label }}</p>
  <h2 class="h2">{{ st.heading }}</h2>
  <div class="prose about-page">
    {{ st.text | markdown | safe }}
    {%- if st.buttons %}{% set buttons = st.buttons %}
    <p>{% include "buttons.njk" %}</p>
    {%- endif %}
  </div>
</section>
<div class="wrap gallery">
  {% for photo in modeling.photos %}
  <figure class="gallery__item" data-name="{{ photo.file | fileName }}">
    <a href="{{ ('/assets/img/modeling/' + photo.file) | original }}"><img src="{{ ('/assets/img/modeling/' + photo.file) | resized(900) }}" alt="{{ photo.alt }}. Photo by {{ modeling.credit.name }}." loading="lazy"></a>
  </figure>
  {% endfor %}
</div>
<p class="wrap credit credit--foot label label--small">All photographs © {{ modeling.credit.name }} · <a href="{{ modeling.credit.url }}">{{ modeling.credit.url | replace("https://", "") }}</a></p>
