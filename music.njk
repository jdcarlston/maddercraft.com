---
layout: base.njk
title: Music
permalink: /music/
eleventyComputed:
  description: "{{ pages['music'].description }}"
---
{# The words are in _data/pages/music.yml (editable in /admin). #}
{#- The words are in _data/pages/music.yml; the band, intro and releases are in _data/music.yml (edit both in /admin). -#}
{% set p = { label: pages.music.label, title: music.band, intro: music.intro, buttons: pages.music.buttons } %}{% include "page-head.njk" %}
{# One row per release: its cover (all covers the same height), its name and year, then its songs. #}
<div class="wrap">
  <ol class="list release-list">
    {% for r in music.releases %}
    <li class="release-row" id="{{ r.title | slugify }}">
      <img class="release-row__cover" src="{{ ('/assets/img/music/' + r.file) | resized }}" alt="{{ r.title }} album cover" loading="lazy">
      <div class="release-row__info">
        <h2 class="release-row__title">{{ r.title }}</h2>
        <p class="label label--small">{{ r.note }}</p>
        {% if r.tracks %}{% include "tracks.njk" %}{% endif %}
      </div>
    </li>
    {% endfor %}
  </ol>
</div>
<section class="section"><div class="wrap">
  <p class="label">{{ pages.music.performanceLabel }}</p>
  <h2 class="h2">{{ pages.music.performanceHeading }}</h2>
  <div class="performances">
    {% for p in music.performances %}<img src="{{ ('/assets/img/music/' + p.file) | resized(900) }}" alt="{{ p.alt }}" loading="lazy">{% endfor %}
  </div>
</div></section>
<script src="/assets/js/player.js" defer></script>
