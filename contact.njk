---
layout: base.njk
title: Contact
permalink: /contact/
description: Ask JD Carlston about ritual, ceremony, magickal work or an art commission, and book a preliminary consultation.
---
<section class="page-head wrap">
  <p class="label">Contact</p>
  <h1 class="title">Begin a Working</h1>
  <p class="intro">For ritual, ceremony, magickal work and art commissions. Tell me what you're calling in. You'll get my calendar link to book a preliminary consultation. I read every message and reply personally within two business days.</p>
</section>

<div class="wrap">
  <form class="contact" name="contact" method="POST" action="/contact/thanks/" data-netlify="true" netlify-honeypot="bot-field">
    <input type="hidden" name="form-name" value="contact">
    <p class="contact__hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off"></label></p>

    <fieldset class="contact__kinds">
      <legend class="label">What kind of work?</legend>
      <div class="chips">
      {% for k in contact.kinds %}<label class="chip"><input type="radio" name="kind" value="{{ k.name }}" id="kind-{{ k.id }}"{% if loop.first %} required{% endif %}><span>{{ k.name }}</span></label>{% endfor %}
      </div>
    </fieldset>

    <div class="contact__row">
      <label class="field"><span class="label label--small">Name</span><input id="c-name" name="name" type="text" autocomplete="name" required></label>
      <label class="field"><span class="label label--small">Email</span><input id="c-email" name="email" type="email" autocomplete="email" required></label>
    </div>
    <label class="field"><span class="label label--small">When are you hoping for? (optional)</span><input name="timing" type="text"></label>
    <label class="field"><span class="label label--small">Tell me about it</span><textarea name="message" rows="7" required></textarea></label>

    <button class="btn btn--rose" type="submit">Send and book a consult</button>
    <p class="contact__status" role="status" aria-live="polite"></p>
  </form>
</div>

<script>
(function () {
  var calendly = {{ contact.calendly | dump | safe }};
  var form = document.querySelector("form.contact");
  var status = form.querySelector(".contact__status");

  // /contact/?kind=ceremony preselects a chip
  var want = new URLSearchParams(location.search).get("kind");
  if (want) { var r = document.getElementById("kind-" + want); if (r) r.checked = true; }

  form.addEventListener("submit", function (e) {
    e.preventDefault();
    var btn = form.querySelector("button");
    btn.disabled = true;
    status.textContent = "Sending…";
    var data = new URLSearchParams(new FormData(form)).toString();
    fetch("/", { method: "POST", headers: { "Content-Type": "application/x-www-form-urlencoded" }, body: data })
      .then(function (res) {
        if (!res.ok) throw new Error(res.status);
        status.textContent = "Thank you. Taking you to my calendar…";
        var q = new URLSearchParams({ name: form.name.value, email: form.email.value });
        location.href = calendly + "?" + q.toString();
      })
      .catch(function () { form.submit(); });
  });
})();
</script>
