<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title and title != site.name %}{{ title }} · {% endif %}{{ site.name }}</title>
<meta name="description" content="{{ description or site.description }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or site.description }}">
{# The picture shown when a link is shared. share.jpg is 1200x630, the standard preview size, with the whole
   Pleromic Nursery art in the middle so nothing important gets cropped. A page can set its own with `ogImage`. #}
<meta property="og:image" content="{{ site.url }}{{ ogImage or '/assets/img/share.jpg' }}">
{% if not ogImage %}<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">{% endif %}
<meta property="og:image:alt" content="The Pleromic Nursery artwork: a woman with flowing red hair, her anatomy drawn in art nouveau style, with a baby in the womb">
<meta property="og:type" content="website">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta name="twitter:card" content="summary_large_image">
{% set shareImage = site.url + (ogImage or "/assets/img/share.jpg") %}{% structuredData shareImage %}
<link rel="icon" type="image/png" href="/assets/img/favicon.png">
<link rel="apple-touch-icon" href="/assets/img/apple-touch-icon.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600&family=EB+Garamond:ital,wght@0,400;0,500;1,400;1,500&family=Lancelot&display=swap">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body{% if site.showFileNames %} class="show-names"{% endif %}>
<a class="skip" href="#main">Skip to content</a>
<div class="page">
  <div class="border border--right" aria-hidden="true"></div>
  <div class="border border--left" aria-hidden="true"></div>
  {% include "frame.njk" %}

  <header class="masthead{% if heroHeader %} masthead--over{% endif %}">
    <a class="brand" href="/">
      <img src="/assets/img/logo.svg" alt="" width="115" height="115">
      <span class="brand__name">Madder Craft</span>
    </a>
    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="main-nav">Menu</button>
    <nav class="nav" id="main-nav" aria-label="Main">
      {% for item in site.nav %}
        {% if item.children %}
        <div class="nav__group">
          <a href="{{ item.href }}"{% if item | isCurrent(page.url) %} aria-current="{{ 'page' if page.url == item.href else 'true' }}"{% endif %}>{{ item.label }}</a>
          <div class="nav__sub">
            {% for child in item.children %}<a href="{{ child.href }}"{% if child | isCurrent(page.url) %} aria-current="page"{% endif %}>{{ child.label }}</a>{% endfor %}
          </div>
        </div>
        {% else %}
        <a href="{{ item.href }}"{% if item | isCurrent(page.url) %} aria-current="page"{% endif %}>{{ item.label }}</a>
        {% endif %}
      {% endfor %}
    </nav>
  </header>

  <main id="main">
    {{ content | safe }}
  </main>

  <footer class="footer" id="about">
    <div class="divider" aria-hidden="true"><span></span>{% include "rose.njk" %}<span></span></div>
    <img src="/assets/img/logo.svg" alt="" width="199" height="199">
    <p class="footer__name">Madder Craft</p>
    <p class="footer__line">Visual art, music, poetry, ritual and ceremony.</p>
    <nav class="footer__links" aria-label="Elsewhere">
      {% for l in site.elsewhere %}<a href="{{ l.href }}">{{ l.label }}</a>{% endfor %}
    </nav>
    <p class="footer__about">Madder Craft is the creative practice of JD Carlston, who also owns <a href="https://red-thread-labs.com">Red Thread Labs LLC</a>, where she runs coaching, workshops and retreats. For her engineering and leadership work, visit <a href="https://jdcarlston.com">jdcarlston.com</a>.</p>
    <p class="footer__small">© {{ site.year }} Madder Craft</p>
  </footer>
</div>
<script src="/assets/js/forms.js" defer></script>
<script src="/assets/js/menu.js" defer></script>
<script src="/assets/js/slider.js" defer></script>
</body>
</html>
