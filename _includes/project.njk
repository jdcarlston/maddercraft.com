---
layout: base.njk
---
{# A project page: a title, a photo gallery, then the story in the project's own words.
   Used by every file in /projects. Photos come from the `photos` list in the file's header.
   An optional `video` plays above the photos.
   Optional forms at the bottom: a `request` block (book it for an event) or a
   `support` block (help build or fund it). #}
{% set photoFolder = "/assets/img/projects/" + page.fileSlug + "/" %}
<article class="project">
  <header class="page-head wrap">
    <p class="label">Art{% if status %} · {{ status }}{% endif %}</p>
    <h1 class="title">{{ title }}</h1>
    {% if subtitle %}<p class="intro">{{ subtitle | keepSentences | safe }}</p>{% endif %}
    {% if request %}<a class="btn btn--rose" href="#request">{{ request.heading }}</a>{% endif %}
    {% if support %}<a class="btn btn--rose" href="#support">{{ support.heading }}</a>{% endif %}
  </header>

  {# Optional videos from the media bucket (see `media` in _data/site.js), shown above the photos.
     Use `videos:` for a list, or `video:` for just one. Each has `file`, and optionally `poster` and `caption`.
     The first one plays silently on a loop; the others wait for a click. The controls turn the sound on. #}
  {% set clips = videos if videos else ([video] if video else []) %}
  {% if clips.length %}
  <div class="wrap project-videos">
    {% for clip in clips %}
    <figure class="project-video{% if loop.first %} project-video--lead{% endif %}">
      <video src="{{ site.media }}/{{ clip.file }}"{% if clip.poster %} poster="{{ site.media }}/{{ clip.poster }}"{% endif %} controls playsinline{% if loop.first %} muted loop autoplay preload="metadata"{% else %} preload="none"{% endif %}></video>
      {% if clip.caption %}<figcaption>{{ clip.caption }}</figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  {% if photos and photos.length %}
  <div class="wrap gallery gallery--project">
    {% for photo in photos %}
    <figure class="gallery__item" data-name="{{ photo.file | fileName }}">
      <a href="{{ (photoFolder + photo.file) | original }}"><img src="{{ (photoFolder + photo.file) | resized(900) }}" alt="{{ photo.alt }}" loading="lazy"></a>
      {% if photo.caption %}<figcaption><span class="tile__title">{{ photo.caption }}</span></figcaption>{% endif %}
    </figure>
    {% endfor %}
  </div>
  {% endif %}

  {# Optional `tracks`: songs from the media bucket, played with the same player as the Music page. #}
  {% if tracks %}
  {% set r = { tracks: tracks } %}
  <div class="wrap project-tracks">{% include "tracks.njk" %}</div>
  <script src="/assets/js/player.js" defer></script>
  {% endif %}

  <div class="wrap"><div class="prose project__story">{{ content | safe }}</div></div>
  {% if request %}{% include "event-request.njk" %}{% endif %}
  {% if support %}{% include "support-request.njk" %}{% endif %}
  {% if invite != false %}{% include "invite.njk" %}{% endif %}
  <nav class="wrap pager" aria-label="More art in progress"><span></span><a class="pager__all" href="/art/#in-progress"><span class="label">More art in progress</span></a><span></span></nav>
</article>
