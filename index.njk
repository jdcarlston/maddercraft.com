---
layout: base.njk
title: Madder Craft
heroHeader: true
---
{#- The words are in _data/pages/home.yml (edit in /admin under Pages). The art, music and ritual lists come from
    _data/art.yml, _data/music.yml and _data/ritual.yml. -#}
<section class="hero">
  <img class="hero__bg" src="{{ '/assets/img/pleromic-nursery-art.jpg' | resized(1920) }}" alt="" aria-hidden="true">
  <div class="hero__wash" aria-hidden="true"></div>
  <div class="hero__inner">
    <h1 class="hero__title">
      {% set archText = "Madder Craft" %}{% set archId = "arc-home" %}
      {% set archTagline = pages.home.heroTagline %}{% set archTaglineSize = 20 %}
      {#- 50.6 (not 50) puts "Art" right at the bottom of the curve, since the words either side aren't quite the same length.
          Change or reorder the words and this needs a new number. #}
      {% set archTaglineCenter = 50.6 %}
      {% set archTaglineGap = 7 %}{#- extra room either side of each diamond #}
      {% set archTaglineLinks = [
        { text: "Writing", href: "/poetry/" }, { diamond: true },
        { text: "Music", href: "/music/" }, { diamond: true },
        { text: "Art", href: "/art/" }, { diamond: true },
        { text: "Fashion", href: "/fashion/" }, { diamond: true },
        { text: "Ritual", href: "/ritual/" }
      ] %}
      {% set archLink = "/art/" %}{% set archLinkText = "View" %}
      {% include "arch-title.njk" %}
    </h1>
  </div>
</section>

<section class="section" id="visual-art">
  <div class="section__head wrap">
    <div><p class="label">{{ pages.home.art.label }}</p><h2 class="h2">{{ pages.home.art.heading }}</h2><p class="intro">{{ art.intro }}</p></div>
    <a class="more" href="/art/">See all →</a>
  </div>
  {% set items = art.pieces | piecesByFile(art.featured) | artTiles %}
  {% set height = 460 %}{% set rowLabel = "Selected artwork" %}{% include "row.njk" %}
</section>

<section class="section" id="music">
  <div class="section__head wrap">
    <div><p class="label">{{ pages.home.music.label }}</p><h2 class="h2">{{ music.band }}</h2><p class="intro">{{ music.intro }}</p></div>
    <a class="more" href="/music/">See all →</a>
  </div>
  {% set items = music.releases | musicTiles %}
  {% set height = 400 %}{% set rowLabel = "Rose Madder album covers" %}{% include "row.njk" %}
</section>

{% set feature = null %}{% for p in collections.poems %}{% if p.fileSlug == pages.home.poetry.featuredPoem %}{% set feature = p %}{% endif %}{% endfor %}
<section class="section" id="poetry">
  <div class="wrap feature">
    <div class="feature__text">
      <p class="label">{{ pages.home.poetry.label }}</p>
      <h2 class="h2">{{ feature.data.title }}</h2>
      <p class="feature__lines">{{ feature.content | openingLines(4) }}</p>
      <a class="more" href="{{ feature.url }}">Read the poem →</a>
    </div>
    <div class="feature__img"><img src="{{ feature.content | firstImage | resized(900) }}" alt="{{ pages.home.poetry.featuredImageAlt }}" loading="lazy"></div>
  </div>
  <div class="wrap cards">
    {% set shown = 0 %}{% for p in collections.poems %}{% if p.fileSlug != pages.home.poetry.featuredPoem and shown < 4 %}{% set shown = shown + 1 %}
    <article class="card">
      <p class="label label--small">{{ p.date | monthYear }}</p>
      <h3><a href="{{ p.url }}">{{ p.data.title }}</a></h3>
      <p class="card__lines">{{ p.content | openingLines(2) }}</p>
    </article>{% endif %}{% endfor %}
  </div>
  <div class="wrap center"><a class="btn btn--line" href="/poetry/">All {{ collections.poems.length }} poems</a></div>
</section>

<section class="ritual" id="ritual">
  {#- Two columns: the photo slider on the left, starting level with the first paragraph; the heading sits above the text on the right. #}
  <div class="wrap ritual__inner">
    {%- set r = pages.home.ritual %}
    <div class="ritual__head">
      <p class="label">{{ r.label }}</p>
      <h2 class="h2">{{ r.heading }}</h2>
    </div>
    {#- ifAsync, not if: the photos go through the async "resized" filter, which a plain if skips. #}
    {%- ifAsync ritual.photos and ritual.photos.length %}
    <div class="ritual__slider">
      {% set slides = ritual.photos | ritualTiles %}{% set sliderLabel = "Ritual and ceremony photos" %}{% include "slider.njk" %}
    </div>
    {%- endif %}
    <div class="ritual__body">
      {% for l in r.ledes %}<p class="ritual__lede">{{ l | markdownInline | safe }}</p>
      {% endfor %}
      <ul class="list">
        {% for e in ritual.events %}<li><span>{{ e.name }}</span><span class="label label--small">{{ e.when }}</span></li>
        {% endfor %}
      </ul>
      {% set buttons = r.buttons %}{% include "buttons.njk" %}
    </div>
  </div>
</section>
